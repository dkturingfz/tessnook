{
  "name": "tessnook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test:e2e": "playwright test --trace off",
    "test:db": "scripts/test-db.sh",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "test:contract:supabase": "vitest run tests/contract/supabase.contract.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.119.2",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.7",
    "vite": "^6.4.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Tessnook — a spatial board for priorities and work"
}
